.deucarian-viewer-navigation-root {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    min-height: 100%;
    flex-grow: 1;
    flex-shrink: 0;
    justify-content: flex-end;
    align-items: center;
}

.deucarian-viewer-navigation-toolbar {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}

.deucarian-viewer-navigation-glass {
    background-color: rgba(28, 36, 46, 0.94);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(255, 255, 255, 0.46);
    border-right-color: rgba(255, 255, 255, 0.46);
    border-top-color: rgba(255, 255, 255, 0.46);
    border-bottom-color: rgba(255, 255, 255, 0.46);
}

.deucarian-viewer-navigation-button {
    display: flex;
    flex-shrink: 0;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    font-size: 0;
    -unity-text-align: middle-center;
    align-items: center;
    justify-content: center;
    opacity: 1;
    visibility: visible;
}

.deucarian-viewer-navigation-button:disabled,
.deucarian-viewer-navigation-button.unity-disabled {
    opacity: 1;
}

.deucarian-viewer-navigation-icon {
    flex-grow: 0;
    flex-shrink: 0;
}

.deucarian-viewer-navigation-icon--orbit {
    background-image: resource("Deucarian/ViewerNavigationOrbit");
}

.deucarian-viewer-navigation-icon--fly {
    background-image: resource("Deucarian/ViewerNavigationFly");
}

.deucarian-viewer-navigation-icon--recenter {
    background-image: resource("Deucarian/ViewerNavigationRecenter");
}

.deucarian-viewer-navigation-icon--orthographic {
    background-image: resource("Deucarian/ViewerNavigationOrthographic");
}

.deucarian-viewer-navigation-icon--perspective {
    display: none;
    background-image: resource("Deucarian/ViewerNavigationPerspective");
}

